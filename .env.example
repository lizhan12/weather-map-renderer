# py_draw 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===================
# 基础路径配置
# ===================

# 基础路径（如果不单独指定各路径，则默认使用此路径 + 子目录）
PYDRAW_BASE_PATH=/home/tu

# 单独指定各路径（优先于 base_path）
# PYDRAW_SHAPE_PATH=/path/to/shapefiles
# PYDRAW_IMG_PATH=/path/to/images
# PYDRAW_LOG_PATH=/path/to/logs
# PYDRAW_TEMP_PATH=/path/to/temp
# PYDRAW_IMG_DATA_PATH=/path/to/imgs/data

# ===================
# 图片尺寸
# ===================

PYDRAW_WIDTH=700
PYDRAW_HEIGHT=700

# ===================
# 缓存配置
# ===================

# 图片缓存过期时间（秒）
PYDRAW_CACHE_TTL=300

# 最大缓存文件数
PYDRAW_CACHE_MAX_FILES=500

# ===================
# 渲染配置
# ===================

# 渲染进程数（0=自动，取 min(cpu, render_max_workers)）
PYDRAW_RENDER_WORKERS=0

# 渲染进程池最大工作数
PYDRAW_RENDER_MAX_WORKERS=4

# ===================
# 数据服务配置
# ===================

# 数据服务 URL
PYDRAW_DATA_SERVICE_URL=

# 加密密钥（SM4）
PYDRAW_DATA_SERVICE_KEY=
PYDRAW_DATA_SERVICE_SIGN_KEY=
